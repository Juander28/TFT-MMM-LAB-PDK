v {xschem version=3.4.5 file_version=1.2

* IGZO thin-film transistor - UCI/INRF process (igzo_mmm_lab)
*
* Adapted from gf180mcuD/libs.tech/xschem/symbols/nfet_10v0_asym.sym
* (Apache-2.0, GlobalFoundries PDK Authors).
*
* THREE TERMINALS, AND D AND S ARE INTERCHANGEABLE.  A TFT sits on glass and
* has no body, so there is no bulk pin to bring out - and every junction
* inside the wrapper is dead, so which way round you draw the device makes no
* difference, as in the real thing.  There is no orientation rule to remember.
*
* B is a magnetic field in tesla, zero by default.  Read the note in
* design.ngspice before using it for anything: classical magnetoresistance at
* this mobility is two parts in ten million per tesla, and b_scale is the
* knob that lets a measured effect drive the model instead.
*
* The pin boxes below are declared in the order D, G, S, and @pinlist expands
* in exactly that order - it must match
*     .subckt igzo_tft d g s
* in libs.tech/ngspice/design.ngspice.  Get the order wrong and the netlist is
* silently wrong.
*
* W, L and ov are drawn dimensions in metres.  spiceprefix=X because the
* device is a subcircuit: the wrapper carries the measured contact resistance
* and the overlap capacitance around the intrinsic level-1 model.
}
G {}
K {type=nmos
format="@spiceprefix@name @pinlist @model W=@W L=@L ov=@ov nf=@nf m=@m B=@B b_scale=@b_scale"
lvs_format="@spiceprefix@name @pinlist @model W=@W L=@L nf=@nf m=@m"
template="name=M1
W=100u
L=10u
ov=5u
nf=1
m=1
B=0
b_scale=1
model=igzo_tft
spiceprefix=X
"
}
V {}
S {}
E {}
L 4 7.5 -22.5 7.5 22.5 {}
L 4 20 -30 20 -17.5 {}
L 4 20 17.5 20 30 {}
L 4 7.5 -17.5 20 -17.5 {}
L 4 7.5 17.5 20 17.5 {}
L 4 -20 0 -7.5 -0 {}
L 4 -7.5 -15 -7.5 15 {}
B 4 -5 -15 -2.5 15 {}
B 5 17.5 -32.5 22.5 -27.5 {name=D dir=inout}
B 5 -22.5 -2.5 -17.5 2.5 {name=G dir=in}
B 5 17.5 27.5 22.5 32.5 {name=S dir=inout}
T {S} 22.5 17.5 0 0 0.15 0.15 {layer=7}
T {D} 22.5 -17.5 2 1 0.15 0.15 {layer=7}
T {G} -10 -10 0 1 0.15 0.15 {layer=7}
T {@name} 30 -20 0 0 0.2 0.2 {}
T {@model} 30 -8.75 0 0 0.2 0.2 {}
T {W=@W L=@L} 30 2.5 0 0 0.2 0.2 {}
