% Magnetic fields and thin-film transistors.
%
% Background for the B and b_scale parameters of igzo_tft.  README.md in this
% directory says what each entry would predict for our own device, and groups
% them so that a field applied during fabrication is not mistaken for a field
% applied during operation.  Metadata checked against Crossref.

% --- field applied during fabrication ---------------------------------------

@article{park2018_magnetic_activation,
  author  = {Park, Jeong Woo and Tak, Young Jun and Na, Jae Won and Lee,
             Heesoo and Kim, Won-Gi and Kim, Hyun Jae},
  title   = {Effect of Static and Rotating Magnetic Fields on
             Low-Temperature Fabrication of {InGaZnO} Thin-Film Transistors},
  journal = {ACS Applied Materials \& Interfaces},
  volume  = {10},
  number  = {19},
  pages   = {16613--16622},
  year    = {2018},
  doi     = {10.1021/acsami.8b02433},
  note    = {Field during processing, not during operation.  A rotating field
             at 1150 rpm gives mu_FE = 12.68 cm^2/Vs at low process
             temperature.  A fabrication option for us, not a model term.}
}

% --- field applied during operation: quantum interference in a-IGZO ---------

@article{wang2017_wl_wal,
  author  = {Wang, Wei-Hsiang and Lyu, Syue-Ru and Heredia, Elica and
             Liu, Shu-Hao and Jiang, Pei-hsun and Liao, Po-Yung and
             Chang, Ting-Chang and Chen, Hua-Mao},
  title   = {Competing weak localization and weak antilocalization in
             amorphous indium--gallium--zinc-oxide thin-film transistors},
  journal = {Applied Physics Letters},
  volume  = {110},
  number  = {2},
  pages   = {022106},
  year    = {2017},
  doi     = {10.1063/1.4974080},
  eprint  = {1703.04007},
  archivePrefix = {arXiv},
  note    = {The reference device: mu = 5.6 cm^2/Vs, V_T = 1.4 V, S.S. = 0.45
             V/dec.  Magnetoconductivity from 1.5 K to 40 K, B up to 0.2 T;
             1.3e-6 e^2/h over the sweep at 40 K, and washing out with rising
             temperature.  A percent-level effect exists in this material at
             this mobility - at liquid-helium temperature.}
}

@article{wang2017_universal,
  author  = {Wang, Wei-Hsiang and Lyu, Syue-Ru and Heredia, Elica and
