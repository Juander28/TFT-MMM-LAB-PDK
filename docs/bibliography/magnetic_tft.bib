% --- field applied during operation: split-drain magnetic sensors -----------

@article{rodriguez2004_magfet_analysis,
  author  = {Rodriguez-Torres, R. and Gutierrez-Dominguez, E. A. and
             Klima, R. and Selberherr, S.},
  title   = {Analysis of Split-Drain {MAGFETs}},
  journal = {IEEE Transactions on Electron Devices},
  volume  = {51},
  number  = {12},
  pages   = {2237--2245},
  year    = {2004},
  doi     = {10.1109/ted.2004.839869},
  note    = {The standard analysis.  The response comes from the roll-off of
             the induced Hall potential along the channel; dI_D/I_D is linear
             in B and largely independent of geometry.}
}

@article{garcia2004_magfet_lowtemp,
  author  = {Garc{\'i}a-Ram{\'i}rez, P. J. and Sandoval-Ibarra, F.},
  title   = {Performance of a {MFS}-based {MOSFET} for low temperature
             applications},
  journal = {Journal of Applied Research and Technology},
  volume  = {2},
  number  = {1},
  pages   = {37--43},
  year    = {2004},
  note    = {Open access.  Sensitivity plotted against carrier mobility and
             temperature over mu = 1e2 to 1e5 cm^2/Vs; below 1 mT detectable
             at 77 K.  Extrapolated to mu = 4.6 cm^2/Vs it gives about
             0.05 %/T, which is mu*B - measurement agreeing with theory.}
}

@article{zhao2014_polysi_magfet,
  author  = {Zhao, Xiaofeng and Wen, Dianzhong and L{\"u}, Meiwei and
